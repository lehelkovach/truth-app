{
  "patchVersion": "0.1",
  "id": "patch:pierson-post-1805-0002",
  "message": "The opinions answer each other: the majority undercuts Barbeyrac (A3) and distinguishes Keeble (A4); the dissent dismisses the ancient authorities (B3, tempora mutantur)",
  "createdAt": "2026-10-27T00:10:00Z",
  "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" },
  "operations": [
    { "op": "addUnit", "unit": { "id": "claim:M9", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "definitional", "modality": "probable", "basis": "evidence", "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805", "source:barbeyrac"], "text": "Barbeyrac's qualification is a commentator's opinion that goes beyond the authorities; possession or occupancy should be confined within the limits those authorities prescribe.", "terms": [{ "symbol": "possession", "candidates": ["concept:possession-corporal", "concept:possession-constructive"] }, { "symbol": "occupancy", "conceptRef": "concept:occupancy" }] } },
    { "op": "addUnit", "unit": { "id": "claim:M9c", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "definitional", "modality": "probable", "basis": "derived", "positionRef": "position:pierson", "text": "The reasonable-prospect standard is not the law governing property in wild animals." } },
    { "op": "addUnit", "unit": { "id": "claim:M10", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "empirical", "modality": "probable", "basis": "evidence", "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805", "source:keeble1707"], "text": "Keeble v. Hickeringill turned on the plaintiff's possession of his own land and the defendant's malicious disturbance of a lawful livelihood, not on pursuit of a wild animal.", "terms": [{ "symbol": "possession", "conceptRef": "concept:possession-corporal" }] } },
    { "op": "addUnit", "unit": { "id": "claim:M11", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "empirical", "modality": "certain", "basis": "evidence", "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805"], "text": "The beach where the fox was taken was waste and uninhabited land, possessed by no one." } },
    { "op": "addUnit", "unit": { "id": "claim:M10c", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "empirical", "modality": "probable", "basis": "derived", "positionRef": "position:pierson", "text": "Keeble v. Hickeringill does not govern a pursuit on unowned land." } },
    { "op": "addUnit", "unit": { "id": "claim:D7", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "normative", "modality": "plausible", "basis": "assumption", "positionRef": "position:post", "sourceRefs": ["source:livingston1805"], "text": "The ancient authorities, written for other times and circumstances, should not govern; the question should be decided by the custom of sportsmen (tempora mutantur).", "terms": [{ "symbol": "custom", "conceptRef": "concept:custom" }] } },
    { "op": "addUnit", "unit": { "id": "claim:D7c", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "normative", "modality": "plausible", "basis": "derived", "positionRef": "position:post", "text": "The authorities relied on do not settle whose the fox is." } },
    { "op": "addUnit", "unit": { "id": "argument:A3", "kind": "argument", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "title": "A commentator's dictum is not the law", "premiseRefs": ["claim:M9", "claim:M8"], "conclusionRef": "claim:M9c", "scheme": "deductive", "strict": true, "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805"], "warrant": "Barbeyrac's extension is a learned author's opinion, not the received law (M9), and the law should prefer the certain rule (M8); so the reasonable-prospect standard is not the law, and Barbeyrac does not carry Post from pursuit to property." } },
    { "op": "addUnit", "unit": { "id": "argument:A4", "kind": "argument", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "title": "Keeble distinguished", "premiseRefs": ["claim:M10", "claim:M11"], "conclusionRef": "claim:M10c", "scheme": "deductive", "strict": true, "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805", "source:keeble1707"], "warrant": "Keeble rested on the plaintiff's possession of the soil and the malice of the disturbance (M10); here the beach was no one's (M11); so the analogy fails." } },
    { "op": "addUnit", "unit": { "id": "argument:B3", "kind": "argument", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "title": "Tempora mutantur: the custom of sportsmen should decide", "premiseRefs": ["claim:D7"], "conclusionRef": "claim:D7c", "scheme": "inductive", "strict": false, "positionRef": "position:post", "sourceRefs": ["source:livingston1805"], "warrant": "Texts written for the Roman or feudal world do not fix whose a fox is on a New York beach; the usage of those who hunt does. So the authorities do not settle the question." } },
    { "op": "addRelation", "relation": { "id": "rel:X5", "operator": "undercut", "from": "argument:A3", "to": "argument:B1", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "note": "The inference from Barbeyrac to the law fails if Barbeyrac is not the law." } },
    { "op": "addRelation", "relation": { "id": "rel:X6", "operator": "undercut", "from": "argument:A4", "to": "argument:B4", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "note": "The analogy to Keeble fails on unowned land." } },
    { "op": "addRelation", "relation": { "id": "rel:X7", "operator": "undercut", "from": "argument:B3", "to": "argument:A1", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "note": "If the authorities do not govern, A1's inference from them fails." } }
  ]
}
