{
  "patchVersion": "0.1",
  "id": "patch:pierson-post-1805-majority-answers-custom-0001",
  "message": "Majority answers the custom argument: the received authorities are the law absent statute (A7); honour among sportsmen is not a legal rule (A8)",
  "createdAt": "2026-10-27T00:20:00Z",
  "authorRef": "actor:lehel",
  "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" },
  "operations": [
    { "op": "addUnit", "unit": { "id": "claim:M13", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "normative", "modality": "probable", "basis": "evidence", "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805"], "text": "In the absence of a statute, the received authorities on animals ferae naturae are the law, and a court may not substitute the usage of sportsmen for them.", "terms": [{ "symbol": "custom", "conceptRef": "concept:custom" }] } },
    { "op": "addUnit", "unit": { "id": "claim:M13c", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "normative", "modality": "probable", "basis": "derived", "positionRef": "position:pierson", "text": "The custom of sportsmen cannot displace the authorities on occupancy." } },
    { "op": "addUnit", "unit": { "id": "claim:M12", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "normative", "modality": "probable", "basis": "evidence", "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805"], "text": "Pierson's conduct, however uncourteous, is a matter for the rules of honour among sportsmen, not a wrong the law redresses; the feared discouragement of the chase is speculative." } },
    { "op": "addUnit", "unit": { "id": "claim:M12c", "kind": "claim", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "claimKind": "normative", "modality": "probable", "basis": "derived", "positionRef": "position:pierson", "text": "The policy of encouraging the chase does not warrant a legal rule vesting property in a pursuer." } },
    { "op": "addUnit", "unit": { "id": "argument:A7", "kind": "argument", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "title": "The authorities are the law absent statute", "premiseRefs": ["claim:M13"], "conclusionRef": "claim:M13c", "scheme": "deductive", "strict": true, "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805"], "warrant": "A court applies the received law; custom among hunters is not law unless adopted (M13); so the custom argument cannot displace the authorities." } },
    { "op": "addUnit", "unit": { "id": "argument:A8", "kind": "argument", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "title": "Honour among sportsmen is not a legal rule", "premiseRefs": ["claim:M12"], "conclusionRef": "claim:M12c", "scheme": "deductive", "strict": true, "positionRef": "position:pierson", "sourceRefs": ["source:pierson1805"], "warrant": "Discourtesy is for the code of sportsmen, not the courts, and the predicted end of the chase is unsupported (M12); so the policy does not justify a property rule." } },
    { "op": "addRelation", "relation": { "id": "rel:X8", "operator": "undercut", "from": "argument:A7", "to": "argument:B3", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "note": "The inference from changed times to displaced authorities fails if the authorities remain the law." } },
    { "op": "addRelation", "relation": { "id": "rel:X9", "operator": "undercut", "from": "argument:A8", "to": "argument:B2", "status": "accepted", "provenance": { "sourceType": "fixture", "sourceRef": "case:pierson-post-1805", "method": "manual_authoring", "actorRef": "actor:lehel" }, "note": "The inference from encouraging the chase to a property rule fails if honour, not law, governs discourtesy." } }
  ]
}
